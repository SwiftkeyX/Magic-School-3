{
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.vs": true,
        "**/.gitmodules": true,
        "**/.vsconfig": true,
        "**/*.booproj": true,
        "**/*.pidb": true,
        "**/*.suo": true,
        "**/*.user": true,
        "**/*.userprefs": true,
        "**/*.unityproj": true,
        "**/*.dll": true,
        "**/*.exe": true,
        "**/*.pdf": true,
        "**/*.mid": true,
        "**/*.midi": true,
        "**/*.wav": true,
        "**/*.gif": true,
        "**/*.ico": true,
        "**/*.jpg": true,
        "**/*.jpeg": true,
        "**/*.png": true,
        "**/*.psd": true,
        "**/*.tga": true,
        "**/*.tif": true,
        "**/*.tiff": true,
        "**/*.3ds": true,
        "**/*.3DS": true,
        "**/*.fbx": true,
        "**/*.FBX": true,
        "**/*.lxo": true,
        "**/*.LXO": true,
        "**/*.ma": true,
        "**/*.MA": true,
        "**/*.obj": true,
        "**/*.OBJ": true,
        "**/*.asset": true,
        "**/*.cubemap": true,
        "**/*.flare": true,
        "**/*.mat": true,
        "**/*.meta": true,
        "**/*.prefab": true,
        "**/*.unity": true,
        "build/": true,
        "Build/": true,
        "Library/": true,
        "library/": true,
        "obj/": true,
        "Obj/": true,
        "Logs/": true,
        "logs/": true,
        "ProjectSettings/": true,
        "UserSettings/": true,
        "temp/": true,
        "Temp/": true
    },
    "files.associations": {
        "*.asset": "yaml",
        "*.meta": "yaml",
        "*.prefab": "yaml",
        "*.unity": "yaml",
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.sln": "*.csproj",
        "*.slnx": "*.csproj"
    },
    "dotnet.defaultSolution": "Magic School 3.slnx",
    "dotnet.enableWorkspaceBasedDevelopment": false,
    // ===================== Todo Tree =====================
    // THE STANDARD. One axis: what action does this need, and from whom?
    //
    //   FIXNOW    Broken or wrong right now, and it blocks. Fix before moving on.
    //   FIXLATER  Could be fixed TODAY, chose not to. This is the "pick something up" list.
    //   BLOCKED   Can't be done until something else exists. Always name the blocker.
    //   FLAGGING  Looks wrong but IS deliberate - here's why. Do NOT "fix" it.
    //   ASKING    A direct question for whoever reads this. Answer it.
    //   UNSURE    Uneasy about this, but no specific question and no answer yet.
    //
    // FLAGGING is the exact opposite of FIXLATER, which is what makes both worth having:
    // one says "this is wrong, get to it", the other says "this is right, leave it alone".
    // Without the second, a deliberate choice is indistinguishable from a bug someone will
    // helpfully "fix" for you.
    //
    // BLOCKED exists to keep FIXLATER honest. Anything waiting on an unbuilt system is not a
    // thing you can pick up, so it doesn't belong on the list of things you can pick up -
    // it just makes that list look heavier than it is. Write "BLOCKED on: <what>".
    //
    // Self-check: FIXNOW and ASKING are an inbox and should trend to ZERO - they get
    // resolved. FIXLATER, BLOCKED, FLAGGING and UNSURE are an archive and may accumulate.
    // FIXNOW piling up, or FIXLATER growing past what you'd actually read, is the signal.
    //
    // Listed worst-first so the tree sorts by urgency rather than alphabetically.
    "todo-tree.general.tags": [
        "FIXNOW",
        "FIXLATER",
        "BLOCKED",
        "FLAGGING",
        "ASKING",
        "UNSURE"
    ],
    "todo-tree.general.tagGroups": {},
    "todo-tree.highlights.defaultHighlight": {
        "type": "tag",
        "gutterIcon": true
    },
    "todo-tree.highlights.customHighlight": {
        "FIXNOW": {
            "icon": "flame",
            "foreground": "#ffffff",
            "background": "#d13438",
            "iconColour": "#d13438"
        },
        "FIXLATER": {
            "icon": "clock",
            "foreground": "#1f1f1f",
            "background": "#e3a008",
            "iconColour": "#e3a008"
        },
        // Muted grey on purpose: BLOCKED items are not actionable, so they shouldn't compete
        // for attention with the ones that are.
        "BLOCKED": {
            "icon": "lock",
            "foreground": "#ffffff",
            "background": "#57606a",
            "iconColour": "#57606a"
        },
        "ASKING": {
            "icon": "question",
            "foreground": "#ffffff",
            "background": "#0078d4",
            "iconColour": "#0078d4"
        },
        "UNSURE": {
            "icon": "alert",
            "foreground": "#ffffff",
            "background": "#8661c5",
            "iconColour": "#8661c5"
        },
        // Green, not a warning colour: FLAGGING means "this is correct on purpose".
        "FLAGGING": {
            "icon": "shield-check",
            "foreground": "#ffffff",
            "background": "#2f7d32",
            "iconColour": "#2f7d32"
        }
    },
    // Don't scan Unity's generated folders or imported packages - only our own code.
    "todo-tree.filtering.excludeGlobs": [
        "**/Library/**",
        "**/Temp/**",
        "**/Obj/**",
        "**/Build/**",
        "**/Logs/**",
        "**/Assets/TextMesh Pro/**",
        "**/Packages/**"
    ]
}