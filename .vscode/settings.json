{
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.vs": true,
        "**/.gitmodules": true,
        "**/.vsconfig": true,
        "**/*.booproj": true,
        "**/*.pidb": true,
        "**/*.suo": true,
        "**/*.user": true,
        "**/*.userprefs": true,
        "**/*.unityproj": true,
        "**/*.dll": true,
        "**/*.exe": true,
        "**/*.pdf": true,
        "**/*.mid": true,
        "**/*.midi": true,
        "**/*.wav": true,
        "**/*.gif": true,
        "**/*.ico": true,
        "**/*.jpg": true,
        "**/*.jpeg": true,
        "**/*.png": true,
        "**/*.psd": true,
        "**/*.tga": true,
        "**/*.tif": true,
        "**/*.tiff": true,
        "**/*.3ds": true,
        "**/*.3DS": true,
        "**/*.fbx": true,
        "**/*.FBX": true,
        "**/*.lxo": true,
        "**/*.LXO": true,
        "**/*.ma": true,
        "**/*.MA": true,
        "**/*.obj": true,
        "**/*.OBJ": true,
        "**/*.asset": true,
        "**/*.cubemap": true,
        "**/*.flare": true,
        "**/*.mat": true,
        "**/*.meta": true,
        "**/*.prefab": true,
        "**/*.unity": true,
        "build/": true,
        "Build/": true,
        "Library/": true,
        "library/": true,
        "obj/": true,
        "Obj/": true,
        "Logs/": true,
        "logs/": true,
        "ProjectSettings/": true,
        "UserSettings/": true,
        "temp/": true,
        "Temp/": true
    },
    "files.associations": {
        "*.asset": "yaml",
        "*.meta": "yaml",
        "*.prefab": "yaml",
        "*.unity": "yaml",
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.sln": "*.csproj",
        "*.slnx": "*.csproj"
    },
    "dotnet.defaultSolution": "Magic School 3.slnx",
    "dotnet.enableWorkspaceBasedDevelopment": false,
    // ===================== Todo Tree =====================
    // Urgency is the split that matters: FIXNOW blocks, FIXLATER doesn't.
    // The rest are the notes-to-self/questions already used across the codebase.
    "todo-tree.general.tags": [
        "FIXNOW",
        "FIXLATER",
        "ASKING",
        "UNSURE",
        "FLAGGING",
        "FLAG",
        "NOTE"
    ],
    // Listed worst-first so the tree sorts by urgency rather than alphabetically.
    "todo-tree.general.tagGroups": {},
    "todo-tree.highlights.defaultHighlight": {
        "type": "tag",
        "gutterIcon": true
    },
    "todo-tree.highlights.customHighlight": {
        "FIXNOW": {
            "icon": "flame",
            "foreground": "#ffffff",
            "background": "#d13438",
            "iconColour": "#d13438"
        },
        "FIXLATER": {
            "icon": "clock",
            "foreground": "#1f1f1f",
            "background": "#e3a008",
            "iconColour": "#e3a008"
        },
        "ASKING": {
            "icon": "question",
            "foreground": "#ffffff",
            "background": "#0078d4",
            "iconColour": "#0078d4"
        },
        "UNSURE": {
            "icon": "alert",
            "foreground": "#ffffff",
            "background": "#8661c5",
            "iconColour": "#8661c5"
        },
        "FLAGGING": {
            "icon": "bookmark",
            "foreground": "#1f1f1f",
            "background": "#c2c208",
            "iconColour": "#c2c208"
        },
        "FLAG": {
            "icon": "bookmark",
            "foreground": "#1f1f1f",
            "background": "#c2c208",
            "iconColour": "#c2c208"
        },
        "NOTE": {
            "icon": "note",
            "foreground": "#ffffff",
            "background": "#57606a",
            "iconColour": "#57606a"
        }
    },
    // Don't scan Unity's generated folders or imported packages - only our own code.
    "todo-tree.filtering.excludeGlobs": [
        "**/Library/**",
        "**/Temp/**",
        "**/Obj/**",
        "**/Build/**",
        "**/Logs/**",
        "**/Assets/TextMesh Pro/**",
        "**/Packages/**"
    ]
}