/* Match status - the hint line and the win banner, layered over the board.
   Palette matches Shop.uss and HeroPanel.uss so the three read as one UI. */

.status-layer {
    flex-grow: 1;
    height: 100%;
    width: 100%;
    align-items: center;
    justify-content: center;
}

/* ---------------- the hint line ---------------- */
/* Absolute so it sits at the bottom of the board area without pushing the banner
   off centre - the two are independent, and both can be on screen at once. */
.hint {
    position: absolute;
    bottom: 6px;
    color: rgba(232, 230, 240, 0.75);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    background-color: rgba(18, 16, 28, 0.7);
    padding: 5px 12px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* ---------------- the win banner ---------------- */
.banner {
    align-items: center;
    justify-content: center;
    padding: 16px 28px;
    background-color: rgba(18, 16, 28, 0.9);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.18);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.banner__text {
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(240, 240, 248);
}

/* Winner colours match the HP and mana bars rather than being new ones. */
.banner__text--blue {
    color: rgb(120, 175, 245);
}

.banner__text--red {
    color: rgb(232, 120, 120);
}

.banner__text--draw {
    color: rgba(232, 230, 240, 0.7);
}

.banner__hint {
    font-size: 12px;
    -unity-text-align: middle-center;
    color: rgba(232, 230, 240, 0.6);
    margin-top: 4px;
}

/* Hidden state. display:none rather than opacity, so a hidden banner cannot sit
   invisibly over the board eating nothing but still occupying layout. */
.is-hidden {
    display: none;
}
